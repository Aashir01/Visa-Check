# Copy to .env and fill in. Never commit the real file.

ENVIRONMENT=development
DEBUG=true

# Protects auth tokens AND the at-rest encryption of uploaded passports and
# bank statements. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Changing it makes previously stored documents unreadable.
SECRET_KEY=dev-only-insecure-change-me

# SQLite by default; point at Postgres in production.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/visaguard
DATABASE_URL=sqlite:///./visaguard.db

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI / LLM ---
# Pick your provider: "anthropic" (Claude) or "deepseek".  Both can be
# configured at once; set LLM_PROVIDER to choose which one to use.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_ENABLED=true

# -- Anthropic (Claude) --
ANTHROPIC_API_KEY=

# -- DeepSeek (OpenAI-compatible, much cheaper) --
# Model options: deepseek-chat, deepseek-reasoner
# Pricing ~$0.14/M in / $0.28/M out — set pricing below accordingly.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Hard ceiling per check. The pipeline stops calling the model past this
# rather than silently eating your margin.
LLM_BUDGET_USD_PER_CHECK=0.15
# USD per million tokens.  Defaults are Claude Sonnet pricing; override for
# DeepSeek (~0.14 / 0.28) or other models.
LLM_PRICE_IN_PER_MTOK=3.00
LLM_PRICE_OUT_PER_MTOK=15.00

# --- OCR ---
# A rule pack can override this per corridor via ocr.provider.
#   tesseract     - default, no extra install; falls off a cliff on phone photos
#   paddleocr     - self-hosted PP-OCR, robust on photos, still zero per-check
#                   cost. Needs: pip install paddlepaddle paddleocr
#   claude_vision - best on the worst images, costs tokens per page
OCR_PROVIDER=paddleocr
TESSERACT_LANG=eng
PADDLE_LANG=en
OCR_RASTER_DPI=200

# --- retention (§9) ---
RETENTION_DAYS=30
MAX_UPLOAD_MB=15
MAX_FILES_PER_CHECK=25

FREE_CHECKS_PER_USER=1

# --- tiering (§2) ---
# Free checks run deterministic rules only, so they cost nothing but CPU.
# Every checklist, identity, financial, date and photo rule still runs; only
# the AI review of free-text letters is withheld. Set true to give the whole
# free tier AI as well — then read /admin/costs before your traffic grows.
FREE_TIER_AI_ENABLED=false
# Trial AI analyses granted at signup, so the upsell is a demonstration.
FREE_AI_CREDITS_PER_USER=1
PAID_PLANS=starter,agency,white_label

# --- abuse controls ---
# Enforced per process: exact on one instance, per-instance behind several.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHECKS_PER_DAY=20
RATE_LIMIT_CHECKS_PER_HOUR_IP=10
RATE_LIMIT_UPLOADS_PER_HOUR_IP=120
RATE_LIMIT_AUTH_PER_HOUR_IP=20
MAX_BUNDLE_MB=60

# --- background work ---
# inline: checks run in the API process (development, low volume).
# queue : the API only enqueues; run `python worker.py` to do the work.
WORKER_MODE=inline
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=2.0
WORKER_STALE_MINUTES=15

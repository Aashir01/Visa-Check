# Copy to .env and fill in. Never commit the real file.

ENVIRONMENT=development
DEBUG=true

# Protects auth tokens AND the at-rest encryption of uploaded passports and
# bank statements. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Changing it makes previously stored documents unreadable.
SECRET_KEY=dev-only-insecure-change-me

# SQLite by default; point at Postgres in production.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/visaguard
DATABASE_URL=sqlite:///./visaguard.db

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI ---
# Without a key the app still runs: every deterministic check works and the
# report says the letter-content review was skipped.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_ENABLED=true

# Hard ceiling per check. The pipeline stops calling the model past this
# rather than silently eating your margin.
LLM_BUDGET_USD_PER_CHECK=0.15
LLM_PRICE_IN_PER_MTOK=3.00
LLM_PRICE_OUT_PER_MTOK=15.00

# --- OCR ---
# tesseract (cheap, default) or claude_vision (better on phone photos, costs
# tokens). A rule pack can override this per corridor via ocr.provider.
#   tesseract     - default, no extra install; falls off a cliff on phone photos
#   paddleocr     - self-hosted PP-OCR, robust on photos, still zero per-check
#                   cost. Needs: pip install paddlepaddle paddleocr
#   claude_vision - best on the worst images, costs tokens per page
OCR_PROVIDER=tesseract
TESSERACT_LANG=eng
PADDLE_LANG=en
OCR_RASTER_DPI=200

# --- retention (§9) ---
RETENTION_DAYS=30
MAX_UPLOAD_MB=15
MAX_FILES_PER_CHECK=25

FREE_CHECKS_PER_USER=1
